<?xml version="1.0"?>
<sdf version="1.9">
  <world name="impulse_check">
    <physics name="steps" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
      </link>
    </model>
    <model name="drop">
      <pose>0 0 1 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial>
        <collision name="body_collision"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision>
        <sensor name="imu250" type="imu"><always_on>true</always_on><update_rate>250</update_rate><topic>/impulse/imu250</topic><imu/></sensor>
        <sensor name="imu1000" type="imu"><always_on>true</always_on><update_rate>1000</update_rate><topic>/impulse/imu1000</topic><imu/></sensor>
      </link>
    </model>
  </world>
</sdf>
