<?xml version="1.0" encoding="UTF-8"?>
<!-- Calibration room geometry; see ../maps/calibration.json. -->
<sdf version="1.9">
  <world name="calibration_not_official_field">
    <physics name="calibration_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Arbitrary geodetic datum for optional SITL NavSat, unrelated to competition venue. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0</latitude_deg><longitude_deg>0</longitude_deg>
      <elevation>0</elevation><heading_deg>0</heading_deg>
    </spherical_coordinates>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.75 0.80 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="calibration_light" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="NOT_OFFICIAL_FIELD_ground">
      <static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="ground">
        <collision name="floor_collision"><geometry><box><size>30 30 0.1</size></box></geometry></collision>
        <visual name="floor">
          <geometry><box><size>30 30 0.1</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Inner faces x=+-6, y=+-5. Finite heights z=[0,4]; no ceiling. -->
    <model name="calibration_wall_x_minus">
      <static>true</static><pose>-6.05 0 2 0 0 0</pose>
      <link name="wall">
        <collision name="wall_collision"><geometry><box><size>0.1 10 4</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>0.1 10 4</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="calibration_wall_x_plus">
      <static>true</static><pose>6.05 0 2 0 0 0</pose>
      <link name="wall">
        <collision name="wall_collision"><geometry><box><size>0.1 10 4</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>0.1 10 4</size></box></geometry>
          <material><ambient>0.86 0.86 0.86 1</ambient><diffuse>0.86 0.86 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="calibration_wall_y_minus">
      <static>true</static><pose>0 -5.05 2 0 0 0</pose>
      <link name="wall">
        <collision name="wall_collision"><geometry><box><size>12.2 0.1 4</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>12.2 0.1 4</size></box></geometry>
          <material><ambient>0.78 0.78 0.78 1</ambient><diffuse>0.78 0.78 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="calibration_wall_y_plus">
      <static>true</static><pose>0 5.05 2 0 0 0</pose>
      <link name="wall">
        <collision name="wall_collision"><geometry><box><size>12.2 0.1 4</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>12.2 0.1 4</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Synthetic competition armor mocks: camera +X observes their -X front faces. -->
    <model name="armor_mock_red_a">
      <static>true</static><pose>5 -2 2 0 0 0</pose>
      <link name="armor">
        <collision name="panel"><geometry><box><size>0.012 0.18 0.09</size></box></geometry></collision>
        <visual name="dark_panel"><geometry><box><size>0.012 0.18 0.09</size></box></geometry>
          <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="strip_negative_y"><pose>-0.009 -0.0675 0 0 0 0</pose>
          <geometry><box><size>0.006 0.015 0.055</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material>
        </visual>
        <visual name="strip_positive_y"><pose>-0.009 0.0675 0 0 0 0</pose>
          <geometry><box><size>0.006 0.015 0.055</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material>
        </visual>
        <collision name="stand_collision"><pose>0.03 0 -1.01 0 0 0</pose><geometry><box><size>0.02 0.02 1.98</size></box></geometry></collision>
        <visual name="stand"><pose>0.03 0 -1.01 0 0 0</pose><geometry><box><size>0.02 0.02 1.98</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="armor_mock_red_b">
      <static>true</static><pose>5 2 2 0 0 0</pose>
      <link name="armor">
        <collision name="panel"><geometry><box><size>0.012 0.18 0.09</size></box></geometry></collision>
        <visual name="dark_panel"><geometry><box><size>0.012 0.18 0.09</size></box></geometry>
          <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
        <visual name="strip_negative_y"><pose>-0.009 -0.0675 0 0 0 0</pose>
          <geometry><box><size>0.006 0.015 0.055</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material>
        </visual>
        <visual name="strip_positive_y"><pose>-0.009 0.0675 0 0 0 0</pose>
          <geometry><box><size>0.006 0.015 0.055</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material>
        </visual>
        <collision name="stand_collision"><pose>0.03 0 -1.01 0 0 0</pose><geometry><box><size>0.02 0.02 1.98</size></box></geometry></collision>
        <visual name="stand"><pose>0.03 0 -1.01 0 0 0</pose><geometry><box><size>0.02 0.02 1.98</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- No robot includes, external assets, pose-publisher or scripted observations. -->
  </world>
</sdf>
