+	/** Read the oldest retained publication without changing ordinary subscription policy. */
+	bool copy_retained(void *dst, unsigned &generation)
+	{
+		if (id() != ORB_ID::vehicle_visual_odometry) {
+			return copy(dst, generation);
+		}
+
+		if (dst == nullptr || _data == nullptr) {
+			return false;
+		}
+
+		ATOMIC_ENTER;
+		const unsigned current_generation = _generation.load();
+		if (current_generation == generation) {
+			ATOMIC_LEAVE;
+			return false;
+		}
+
+		const unsigned capacity = get_retention_queue_size();
+		if (!is_in_range(current_generation - capacity, generation, current_generation - 1)) {
+			generation = current_generation - capacity;
+		}
+
+		memcpy(dst, _data + _meta->o_size * (generation % capacity), _meta->o_size);
+		++generation;
+		ATOMIC_LEAVE;
+		return true;
