<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="rmuc_2026_sentry26">
    <physics name="calibration_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.75 0.80 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="calibration_light" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <include>
      <uri>model://rmuc_2026_sentry26</uri>
    </include>
    <model name="operator_overview">
      <static>true</static>
      <pose>0 0 28 0 1.5707963267948966 1.5707963267948966</pose>
      <link name="camera">
        <sensor name="overview" type="camera">
          <topic>/operator/terrain_overview</topic>
          <update_rate>1</update_rate>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1280</width>
              <height>800</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>60</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
